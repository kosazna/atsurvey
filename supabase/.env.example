# Copy to supabase/.env.local (git-ignored) to enable Google sign-in locally; it overrides the
# committed defaults in supabase/.env. Steps: docs/supabase.md → "Google sign-in".
# Restart Supabase after changing it: npx supabase stop && bash scripts/dev.sh
GOOGLE_AUTH_ENABLED=true
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-client-secret
