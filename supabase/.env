# Committed defaults for env() values in config.toml. NEVER put secrets here.
# Your own values (e.g. Google sign-in credentials) go in supabase/.env.local (git-ignored),
# which overrides this file: see supabase/.env.example and docs/supabase.md → Google sign-in.
GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
