# Public hostname of the API (DNS A/AAAA record → the Hetzner VM)
API_DOMAIN=api.example.com
# Image to run (pushed by the "deploy" GitHub workflow)
API_IMAGE=ghcr.io/kosazna/atsurvey-api:latest

# Supabase project (Frankfurt). URL + publishable/anon key; JWTs are verified via JWKS.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Only if the project still uses the legacy shared JWT secret (leave empty for JWKS):
SUPABASE_JWT_SECRET=

# Comma-separated JSON list of allowed web origins
CORS_ORIGINS=["https://app.example.com"]
ALLOW_ANONYMOUS_COMPUTE=true
MAX_UPLOAD_MB=20

# ---- security (defaults are production-safe; see docs/security.md)
# ENVIRONMENT=production is set by docker-compose.yml; the API refuses to start with unsafe settings.
MAX_BODY_MB=10
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_BURST=60
RATE_LIMIT_HEAVY_PER_MINUTE=30
RATE_LIMIT_HEAVY_BURST=10
# 0 = 2 × CPU count
MAX_CONCURRENT_COMPUTATIONS=0
SUGGEST_TIMEOUT_S=10
