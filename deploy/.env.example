# Public hostname of the API (DNS A/AAAA record → the Hetzner VM)
API_DOMAIN=api.example.com
# Image to run (pushed by the "deploy" GitHub workflow)
API_IMAGE=ghcr.io/kosazna/atsurvey-api:latest

# Supabase project (Frankfurt). URL + publishable/anon key; JWTs are verified via JWKS.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# Only if the project still uses the legacy shared JWT secret (leave empty for JWKS):
SUPABASE_JWT_SECRET=

# Comma-separated JSON list of allowed web origins
CORS_ORIGINS=["https://app.example.com"]
ALLOW_ANONYMOUS_COMPUTE=true
MAX_UPLOAD_MB=20
