{
  "$description": "Single source of design tokens for the web app and the generated reports. Edit here, then run `uv run python scripts/build_tokens.py`. The colour values are a neutral placeholder palette until the brand palette is chosen; only change values, not names.",
  "font": {
    "sans": "\"IBM Plex Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "text": {
    "xs": "0.75rem",
    "sm": "0.8125rem",
    "base": "0.875rem",
    "lg": "1rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "3xl": "2rem"
  },
  "leading": { "tight": "1.25", "normal": "1.5" },
  "weight": { "regular": "400", "medium": "500", "semibold": "600" },
  "radius": { "sm": "4px", "md": "6px", "lg": "8px", "xl": "12px", "full": "9999px" },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px"
  },
  "duration": { "fast": "120ms", "normal": "200ms" },
  "ease": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
  "layout": {
    "sidebar-width": "232px",
    "topbar-height": "52px",
    "z-dropdown": "40",
    "z-overlay": "50",
    "z-modal": "60",
    "z-toast": "70"
  },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgb(15 23 42 / 0.05)",
      "md": "0 2px 8px rgb(15 23 42 / 0.06), 0 1px 2px rgb(15 23 42 / 0.04)",
      "lg": "0 12px 32px rgb(15 23 42 / 0.10), 0 2px 6px rgb(15 23 42 / 0.05)"
    },
    "dark": {
      "sm": "0 1px 2px rgb(0 0 0 / 0.4)",
      "md": "0 2px 8px rgb(0 0 0 / 0.45)",
      "lg": "0 12px 32px rgb(0 0 0 / 0.55)"
    }
  },
  "color": {
    "light": {
      "bg": "#fafafa",
      "surface": "#ffffff",
      "surface-raised": "#ffffff",
      "surface-sunken": "#f4f4f5",
      "border": "#e4e4e7",
      "border-strong": "#d4d4d8",
      "text": "#18181b",
      "text-muted": "#52525b",
      "text-subtle": "#a1a1aa",
      "accent": "#2f5bd3",
      "accent-hover": "#2549b0",
      "accent-contrast": "#ffffff",
      "accent-subtle": "#eef2fc",
      "success": "#15803d",
      "success-subtle": "#ecfdf3",
      "warning": "#b45309",
      "warning-subtle": "#fffbeb",
      "danger": "#b91c1c",
      "danger-subtle": "#fef2f2",
      "info": "#2f5bd3",
      "info-subtle": "#eef2fc",
      "focus": "#2f5bd3",
      "overlay": "rgb(9 9 11 / 0.35)",
      "point-control": "#c2410c",
      "point-traverse": "#2f5bd3",
      "point-detail": "#52525b",
      "traverse-line": "#2f5bd3",
      "map-bg": "#fafafa",
      "map-grid": "#ececef"
    },
    "dark": {
      "bg": "#0b0b0d",
      "surface": "#121214",
      "surface-raised": "#18181b",
      "surface-sunken": "#0e0e10",
      "border": "#26262b",
      "border-strong": "#3f3f46",
      "text": "#f4f4f5",
      "text-muted": "#a1a1aa",
      "text-subtle": "#71717a",
      "accent": "#7c9cf0",
      "accent-hover": "#97b0f4",
      "accent-contrast": "#0b0b0d",
      "accent-subtle": "#1a2340",
      "success": "#4ade80",
      "success-subtle": "#0f2418",
      "warning": "#fbbf24",
      "warning-subtle": "#2a2110",
      "danger": "#f87171",
      "danger-subtle": "#2c1414",
      "info": "#7c9cf0",
      "info-subtle": "#1a2340",
      "focus": "#7c9cf0",
      "overlay": "rgb(0 0 0 / 0.6)",
      "point-control": "#fb923c",
      "point-traverse": "#7c9cf0",
      "point-detail": "#a1a1aa",
      "traverse-line": "#7c9cf0",
      "map-bg": "#0b0b0d",
      "map-grid": "#1c1c20"
    }
  }
}
