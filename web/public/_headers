# Cloudflare Pages response headers. See docs/security.md (web).
# - script-src: the hash is the inline theme bootstrap in index.html; CI checks it
#   (scripts/check_csp.py). Change both together.
# - connect-src / img-src: engine API, Supabase (REST, auth, realtime, storage), map tiles,
#   Paddle checkout, Cloudflare Turnstile (sign-in bot check). Replace api.atsurvey.gr with the real API host before deploying.
# - style-src 'unsafe-inline': required for style attributes (portal element, MapLibre).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-4KrOe9Pin6kOUdoL00QUe0Af2jOw2qFZSmgimAbo91I=' https://cdn.paddle.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://server.arcgisonline.com https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://api.atsurvey.gr https://*.supabase.co wss://*.supabase.co https://tile.openstreetmap.org https://server.arcgisonline.com https://*.paddle.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src https://*.paddle.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(self "https://buy.paddle.com" "https://sandbox-buy.paddle.com"), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
